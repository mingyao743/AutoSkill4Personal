# qdoc token（三级查找的最高优先级）
# 平台在 qdoc.chat 的「通行证」页获取
QDOC_TOKEN=

# MCP 端点（一般不用改）
# QDOC_MCP_URL=https://qdoc.chat/mcp

# 编译触发：满多少轮编译一次（默认 30）
# OW_TURNS=30

# 会话空闲多久算一轮结束（默认 90 秒）
# OW_IDLE_MS=90000

# 自动初始化 .qdoc/（默认 false：只往已有 vault 写）
# OW_AUTO_INIT=0

# 机器级配置目录（预算与机器锁；默认 ~/.config/qdoc）
# QDOC_MACHINE_DIR=

# 调试：打印完整堆栈
# OW_DEBUG=1
